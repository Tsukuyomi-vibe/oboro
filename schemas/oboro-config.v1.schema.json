{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oboro:config:1",
  "title": "oboro configuration v1",
  "description": "Portable saved settings. Runtime validators additionally check finite numbers, trimmed strings/control characters, Intl locale/time-zone support, language-tag normalization, hosts, permission patterns and duplicate rules. Published v1 readers must remain supported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "oboroVersion", "config", "permissionHints"],
  "properties": {
    "format": { "const": "oboro-config" },
    "schemaVersion": { "const": 1 },
    "oboroVersion": { "type": "string", "pattern": "^\\d{1,5}(?:\\.\\d{1,5}){1,3}$", "description": "Exporter manifest.version; each numeric component is at most 65535. It does not select a schema reader." },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "sitePolicy", "ui"],
      "properties": {
        "profile": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/profile" }] },
        "sitePolicy": { "$ref": "#/$defs/sitePolicy" },
        "ui": {
          "type": "object", "additionalProperties": false, "required": ["language", "theme"],
          "properties": { "language": { "enum": ["en", "ru"] }, "theme": { "enum": ["system", "light", "dark"] } }
        }
      }
    },
    "permissionHints": {
      "type": "object", "additionalProperties": false, "required": ["origins"],
      "properties": {
        "origins": {
          "type": "array", "maxItems": 2000,
          "items": { "type": "string", "maxLength": 512, "pattern": "^https?://[^/]+/\\*$" },
          "description": "HTTP/HTTPS match patterns without a path or port; informational only, never automatic permission grants. Duplicates are normalized."
        }
      }
    }
  },
  "$defs": {
    "nullableNonnegative": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }], "default": null },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "geolocation", "languages", "locale", "timeZone"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "geolocation": {
          "type": "object", "additionalProperties": false, "required": ["latitude", "longitude", "accuracy"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "accuracy": { "type": "number", "minimum": 0 },
            "altitude": { "type": ["number", "null"], "default": null },
            "altitudeAccuracy": { "$ref": "#/$defs/nullableNonnegative" },
            "speed": { "$ref": "#/$defs/nullableNonnegative" },
            "heading": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }], "default": null }
          }
        },
        "languages": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "locale": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string", "minLength": 1 },
        "keyboardLayout": { "enum": ["native", "us-qwerty", "de-qwertz", "ru-jcuken"], "default": "native" }
      }
    },
    "siteRule": {
      "type": "object", "additionalProperties": false, "required": ["host", "schemes", "includeSubdomains"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "schemes": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["http", "https"] } },
        "includeSubdomains": { "type": "boolean" }
      }
    },
    "sitePolicy": {
      "type": "object", "additionalProperties": false, "required": ["mode", "include", "exclude"],
      "properties": {
        "mode": { "enum": ["selected_sites", "all_granted_sites"] },
        "include": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/siteRule" } },
        "exclude": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/siteRule" } }
      }
    }
  }
}
