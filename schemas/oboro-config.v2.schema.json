{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oboro:config:2",
  "title": "oboro configuration v2",
  "description": "Portable saved settings. Only the profile name is required. An omitted override keeps the receiving browser's native value, never the exporting PC's value. Runtime validators additionally check finite numbers, normalized languages, Intl support, hosts, permission patterns and duplicate rules. Published v1 files remain supported with their original defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "oboroVersion", "config", "permissionHints"],
  "properties": {
    "format": { "const": "oboro-config" },
    "schemaVersion": { "const": 2 },
    "oboroVersion": { "type": "string", "pattern": "^\\d{1,5}(?:\\.\\d{1,5}){1,3}$", "description": "Exporter manifest.version; numeric components are at most 65535. It does not select a schema reader." },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "sitePolicy", "ui"],
      "properties": {
        "profile": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/profile" }] },
        "sitePolicy": { "$ref": "#/$defs/sitePolicy" },
        "ui": {
          "type": "object", "additionalProperties": false, "required": ["language", "theme"],
          "properties": { "language": { "enum": ["en", "ru"] }, "theme": { "enum": ["system", "light", "dark"] } }
        }
      }
    },
    "permissionHints": {
      "type": "object", "additionalProperties": false, "required": ["origins"],
      "properties": {
        "origins": {
          "type": "array", "maxItems": 2000,
          "items": { "type": "string", "maxLength": 512, "pattern": "^https?://[^/]+/\\*$" },
          "description": "Informational HTTP/HTTPS host access hints. Import does not grant access. Duplicates are normalized."
        }
      }
    }
  },
  "$defs": {
    "nullableNonnegative": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] },
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "geolocation": {
          "type": "object", "additionalProperties": false,
          "description": "Only present fields are overridden in native get/watch results. An empty object keeps all geolocation APIs native. Null explicitly means unknown for the four nullable fields; omission means native.",
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "accuracy": { "type": "number", "minimum": 0 },
            "altitude": { "type": ["number", "null"] },
            "altitudeAccuracy": { "$ref": "#/$defs/nullableNonnegative" },
            "speed": { "$ref": "#/$defs/nullableNonnegative" },
            "heading": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }] }
          }
        },
        "languages": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "Omission keeps both navigator languages and Accept-Language native." },
        "locale": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string", "minLength": 1 },
        "keyboardLayout": { "enum": ["native", "us-qwerty", "de-qwertz", "ru-jcuken"], "default": "native", "description": "The native marker preserves each receiving PC's map; it contains no captured keys." }
      }
    },
    "siteRule": {
      "type": "object", "additionalProperties": false, "required": ["host", "schemes", "includeSubdomains"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "schemes": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["http", "https"] } },
        "includeSubdomains": { "type": "boolean" }
      }
    },
    "sitePolicy": {
      "type": "object", "additionalProperties": false, "required": ["mode", "include", "exclude"],
      "properties": {
        "mode": { "enum": ["selected_sites", "all_granted_sites"] },
        "include": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/siteRule" } },
        "exclude": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/siteRule" } }
      }
    }
  }
}
